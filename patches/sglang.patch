+"""Unit tests for the should_apply_lora opt-in gate in LoRAManager and the
+Qwen3-Omni regex that drives it.
+
+These tests are CPU-only and avoid full sglang server bootstrapping. They
+directly construct minimal stand-in PyTorch modules and call
+``LoRAManager.init_lora_modules()`` through ``LoRAManager.__new__`` so the
+heavy ``__init__`` path (memory pool, adapter download, etc.) is bypassed.
+
+Run with::
+
+    pytest test/srt/lora/test_should_apply_lora_gate.py -v
+"""
+
+from __future__ import annotations
+
+import re
+import types
+from unittest.mock import MagicMock
+
+import pytest
+import torch.nn as nn
+
+from sglang.srt.lora.lora_manager import LoRAManager
+from sglang.srt.models.qwen3_omni_moe import Qwen3OmniMoeForConditionalGeneration
+
+
+# ---------------------------------------------------------------------------
+# 1. Regex-only checks on Qwen3OmniMoeForConditionalGeneration._lora_pattern.
+#    Pure logic, no torch state required.
+# ---------------------------------------------------------------------------
+
+
+class TestQwen3OmniLoraPattern:
+    pattern = Qwen3OmniMoeForConditionalGeneration._lora_pattern
+
+    @pytest.mark.parametrize(
+        "name",
+        [
+            "thinker.model.layers.0.self_attn.qkv_proj",
+            "thinker.model.layers.47.self_attn.o_proj",
+            "thinker.model.layers.5.mlp.experts",
+            "thinker.lm_head",
+            "thinker.model.embed_tokens",
+        ],
+    )
+    def test_llm_body_matches(self, name):
+        assert self.pattern.match(name) is not None, (
+            f"expected match for {name!r}"
+        )
+
+    @pytest.mark.parametrize(
+        "name",
+        [
+            # audio tower uses the same `layers.<id>.self_attn.qkv_proj`
+            # convention -- this is exactly the collision case the gate
+            # exists to prevent.
+            "thinker.audio_tower.layers.0.self_attn.qkv_proj",
+            "thinker.audio_tower.layers.31.self_attn.o_proj",
+            "thinker.audio_tower.layers.5.fc1",
+            "thinker.audio_tower.conv1",
+            # vision tower has its own naming but must also stay untouched.
+            "thinker.visual.blocks.5.attn.qkv",
+            "thinker.visual.merger.mlp.0",
+            "thinker.visual.patch_embed.proj",
+            # Hypothetical sibling components.
+            "talker.model.layers.0.self_attn.qkv_proj",
+            # Missing thinker prefix -- the LLM is always reached via thinker.
+            "model.layers.0.self_attn.qkv_proj",
+            # Parameter path, not a module path.
+            "thinker.model.embed_tokens.weight",
+            # LLM layernorms must not be wrapped (not in target_modules anyway,
+            # but the regex also excludes them).
+            "thinker.model.layers.0.input_layernorm",
+        ],
+    )
+    def test_non_llm_rejected(self, name):
+        assert self.pattern.match(name) is None, (
+            f"expected NO match for {name!r}"
+        )
+
+    def test_should_apply_lora_method_callable_via_class(self):
+        # The method only reads ``self._lora_pattern`` (class attribute), so
+        # we can bind it to a lightweight namespace without constructing the
+        # full model.
+        fn = Qwen3OmniMoeForConditionalGeneration.should_apply_lora
+        proxy = types.SimpleNamespace(
+            _lora_pattern=Qwen3OmniMoeForConditionalGeneration._lora_pattern
+        )
+        assert fn(proxy, "thinker.model.layers.0.self_attn.qkv_proj") is True
+        assert fn(proxy, "thinker.audio_tower.layers.0.self_attn.qkv_proj") is False
+
+
+# ---------------------------------------------------------------------------
+# 2. Gate integration: LoRAManager.init_lora_modules must honor
+#    base_model.should_apply_lora when present, and must remain a no-op for
+#    legacy models that don't define it.
+# ---------------------------------------------------------------------------
+
+
+class _Qkv(nn.Module):
+    def __init__(self, dim: int = 8):
+        super().__init__()
+        self.qkv_proj = nn.Linear(dim, dim * 3, bias=False)
+        self.o_proj = nn.Linear(dim, dim, bias=False)
+
+
+class _AttnLayer(nn.Module):
+    def __init__(self, dim: int = 8):
+        super().__init__()
+        self.self_attn = _Qkv(dim)
+
+
+class _Body(nn.Module):
+    """Stand-in for ``thinker.model`` -- a stack of attention layers."""
+
+    def __init__(self, n_layers: int = 2, dim: int = 8):
+        super().__init__()
+        self.layers = nn.ModuleList([_AttnLayer(dim) for _ in range(n_layers)])
+
+
+class _Encoder(nn.Module):
+    """Stand-in for ``thinker.audio_tower`` -- intentionally uses the SAME
+    ``layers.<id>.self_attn.{qkv_proj,o_proj}`` naming as the LLM body to
+    reproduce the collision."""
+
+    def __init__(self, n_layers: int = 2, dim: int = 8):
+        super().__init__()
+        self.layers = nn.ModuleList([_AttnLayer(dim) for _ in range(n_layers)])
+
+
+def _make_fake_omni_like_model() -> nn.Module:
+    """Build a tree that mirrors Qwen3-Omni's collision: thinker wraps both
+    a language ``model`` and an ``audio_tower`` whose submodules share names.
+    """
+
+    _pattern = re.compile(
+        r"^thinker\.model\.layers\.\d+\.self_attn\.(?:qkv_proj|o_proj)$"
+    )
+
+    class _Thinker(nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.model = _Body()
+            self.audio_tower = _Encoder()
+
+    class _OmniLike(nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.thinker = _Thinker()
+
+        def should_apply_lora(self, module_name: str) -> bool:
+            return bool(_pattern.match(module_name))
+
+    return _OmniLike()
+
+
+def _bare_lora_manager(base_model, target_modules, num_layers: int = 2):
+    """Construct a LoRAManager skeleton sufficient for ``init_lora_modules``
+    to run without touching memory pools, adapter download, or CUDA."""
+    mgr = LoRAManager.__new__(LoRAManager)
+    mgr.base_model = base_model
+    mgr.target_modules = set(target_modules)
+    mgr.base_hf_config = MagicMock(num_hidden_layers=num_layers)
+    mgr.experts_shared_outer_loras = False
+    mgr.lora_use_virtual_experts = False
+    return mgr
+
+
+def _record_set_lora_module(bucket: list):
+    """Return a ``set_lora_module`` replacement that records names and
+    returns a MagicMock (which tolerates arbitrary attribute writes that the
+    real code performs on the wrapped layer)."""
+
+    def _impl(name, _mod):
+        bucket.append(name)
+        return MagicMock()
+
+    return _impl
+
+
+class TestShouldApplyLoraGate:
+    def test_gate_filters_audio_tower(self):
+        base = _make_fake_omni_like_model()
+        mgr = _bare_lora_manager(base, {"qkv_proj", "o_proj"}, num_layers=2)
+
+        wrapped: list[str] = []
+        mgr.set_lora_module = _record_set_lora_module(wrapped)
+
+        mgr.init_lora_modules()
+
+        leaks = [n for n in wrapped if "audio_tower" in n]
+        assert leaks == [], f"audio_tower modules leaked into LoRA wrap: {leaks}"
+
+        expected = {
+            "thinker.model.layers.0.self_attn.qkv_proj",
+            "thinker.model.layers.0.self_attn.o_proj",
+            "thinker.model.layers.1.self_attn.qkv_proj",
+            "thinker.model.layers.1.self_attn.o_proj",
+        }
+        missing = expected - set(wrapped)
+        assert not missing, f"missing LLM modules from LoRA wrap: {missing}"
+
+    def test_legacy_model_without_hook_keeps_suffix_match(self):
+        class _Vanilla(nn.Module):
+            def __init__(self):
+                super().__init__()
+                self.model = _Body(n_layers=2)
+            # Deliberately no should_apply_lora -> getattr returns None ->
+            # gate is a no-op (legacy suffix matching applies).
+
+        mgr = _bare_lora_manager(_Vanilla(), {"qkv_proj"}, num_layers=2)
+        wrapped: list[str] = []
+        mgr.set_lora_module = _record_set_lora_module(wrapped)
+
+        mgr.init_lora_modules()
+
+        assert "model.layers.0.self_attn.qkv_proj" in wrapped
+        assert "model.layers.1.self_attn.qkv_proj" in wrapped
+
+    def test_deny_all_hook_wraps_nothing(self):
+        class _DenyAll(nn.Module):
+            def __init__(self):
+                super().__init__()
+                self.model = _Body(n_layers=2)
+
+            def should_apply_lora(self, module_name: str) -> bool:
+                return False
+
+        mgr = _bare_lora_manager(_DenyAll(), {"qkv_proj", "o_proj"}, num_layers=2)
+        wrapped: list[str] = []
+        mgr.set_lora_module = _record_set_lora_module(wrapped)
+
+        mgr.init_lora_modules()
+
+        assert wrapped == [], f"deny-all hook should wrap nothing, got: {wrapped}"
+
+
+if __name__ == "__main__":
+    raise SystemExit(pytest.main([__file__, "-v"]))
