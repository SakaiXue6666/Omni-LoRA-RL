+"""Create a toy PEFT-style LoRA adapter for Qwen3-Omni thinker.
+
+Targets the thinker's attention (q/k/v/o) for the first few decoder layers.
+Weights are zero-initialized so the adapter is mathematically a no-op,
+which lets us verify the load/forward plumbing end-to-end without changing
+generation outputs.
+
+After running, the directory layout is:
+  <output_dir>/
+    adapter_config.json
+    adapter_model.safetensors
+"""
+
+import argparse
+import json
+import os
+
+import torch
+from safetensors.torch import save_file
+
+
+HIDDEN = 2048
+NUM_HEADS = 32
+KV_HEADS = 4
+HEAD_DIM = 128
+Q_OUT = NUM_HEADS * HEAD_DIM        # 4096
+KV_OUT = KV_HEADS * HEAD_DIM        # 512
+
+
+def build_state_dict(num_layers: int, rank: int, dtype: torch.dtype):
+    # PEFT-standard init: lora_A = Kaiming-uniform-ish small noise, lora_B = 0.
+    # With lora_B = 0, the product B @ A is exactly 0, so the adapter is a
+    # mathematical no-op even though both matrices live in the safetensors.
+    sd = {}
+    prefix = "base_model.model.thinker.model.layers"
+    gen = torch.Generator().manual_seed(0)
+
+    def small_random(shape):
+        std = 1.0 / (shape[1] ** 0.5)
+        return (torch.randn(*shape, generator=gen) * std).to(dtype)
+
+    for i in range(num_layers):
+        layer_prefix = f"{prefix}.{i}.self_attn"
+
+        for name, out_dim in [
+            ("q_proj", Q_OUT),
+            ("k_proj", KV_OUT),
+            ("v_proj", KV_OUT),
+        ]:
+            sd[f"{layer_prefix}.{name}.lora_A.weight"] = small_random((rank, HIDDEN))
+            sd[f"{layer_prefix}.{name}.lora_B.weight"] = torch.zeros(out_dim, rank, dtype=dtype)
+
+        sd[f"{layer_prefix}.o_proj.lora_A.weight"] = small_random((rank, Q_OUT))
+        sd[f"{layer_prefix}.o_proj.lora_B.weight"] = torch.zeros(HIDDEN, rank, dtype=dtype)
+
+    return sd
+
+
+def build_config(num_layers: int, rank: int, alpha: float):
+    target_layers = list(range(num_layers))
+    target_modules = []
+    for i in target_layers:
+        for name in ["q_proj", "k_proj", "v_proj", "o_proj"]:
+            target_modules.append(f"thinker.model.layers.{i}.self_attn.{name}")
+
+    return {
+        "alpha_pattern": {},
+        "auto_mapping": None,
+        "base_model_name_or_path": "/models/Qwen/Qwen3-Omni-30B-A3B-Instruct",
+        "bias": "none",
+        "fan_in_fan_out": False,
+        "inference_mode": True,
+        "init_lora_weights": True,
+        "layers_pattern": None,
+        "layers_to_transform": None,
+        "lora_alpha": alpha,
+        "lora_dropout": 0.0,
+        "modules_to_save": None,
+        "peft_type": "LORA",
+        "r": rank,
+        "rank_pattern": {},
+        "revision": None,
+        "target_modules": target_modules,
+        "task_type": "CAUSAL_LM",
+    }
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--output", default="/data/xueyulin/models/toy-lora-thinker")
+    ap.add_argument("--num-layers", type=int, default=4,
+                    help="how many of the thinker's first decoder layers to attach LoRA to")
+    ap.add_argument("--rank", type=int, default=32)
+    ap.add_argument("--alpha", type=float, default=None,
+                    help="LoRA alpha (default: equal to rank, scaling=1.0)")
+    ap.add_argument("--dtype", default="bfloat16", choices=["bfloat16", "float16", "float32"])
+    args = ap.parse_args()
+    alpha = args.alpha if args.alpha is not None else float(args.rank)
+
+    dtype = {"bfloat16": torch.bfloat16, "float16": torch.float16, "float32": torch.float32}[args.dtype]
+
+    os.makedirs(args.output, exist_ok=True)
+
+    sd = build_state_dict(args.num_layers, args.rank, dtype)
+    cfg = build_config(args.num_layers, args.rank, alpha)
+
+    safetensors_path = os.path.join(args.output, "adapter_model.safetensors")
+    config_path = os.path.join(args.output, "adapter_config.json")
+
+    save_file(sd, safetensors_path)
+    with open(config_path, "w") as f:
+        json.dump(cfg, f, indent=2)
+
+    total_params = sum(t.numel() for t in sd.values())
+    print(f"Wrote {len(sd)} tensors ({total_params:,} params, dtype={args.dtype}) to:")
+    print(f"  {safetensors_path}")
+    print(f"  {config_path}")
+    print(f"Target layers: 0..{args.num_layers - 1} of thinker; rank={args.rank}, alpha={alpha}, scaling={alpha / args.rank:.6f}")
+
+
+if __name__ == "__main__":
+    main()
