@@ -0,0 +1,123 @@
+"""Offline smoke test that doesn't import sglang.
+
+sglang doesn't import on Windows (uses Unix-only ``resource`` stdlib in
+``sglang.srt.utils.common``). This file re-extracts the regex and gate logic
+from source so we can validate behavior on any platform.
+
+Run with::
+
+    python test/srt/lora/_smoke_offline.py
+"""
+
+from __future__ import annotations
+
+import ast
+import re
+import sys
+from pathlib import Path
+
+
+REPO_ROOT = Path(__file__).resolve().parents[3]
+MODEL_FILE = REPO_ROOT / "python" / "sglang" / "srt" / "models" / "qwen3_omni_moe.py"
+LORA_MGR_FILE = REPO_ROOT / "python" / "sglang" / "srt" / "lora" / "lora_manager.py"
+
+
+def _extract_lora_pattern_source() -> str:
+    """Walk the AST of qwen3_omni_moe.py and pull out the string literal
+    assigned to ``_lora_pattern`` inside Qwen3OmniMoeForConditionalGeneration.
+    """
+    tree = ast.parse(MODEL_FILE.read_text(encoding="utf-8"))
+    for node in ast.walk(tree):
+        if isinstance(node, ast.ClassDef) and node.name == "Qwen3OmniMoeForConditionalGeneration":
+            for stmt in node.body:
+                if (
+                    isinstance(stmt, ast.Assign)
+                    and len(stmt.targets) == 1
+                    and isinstance(stmt.targets[0], ast.Name)
+                    and stmt.targets[0].id == "_lora_pattern"
+                ):
+                    call = stmt.value
+                    assert isinstance(call, ast.Call), "_lora_pattern must be re.compile(...)"
+                    # The argument is either one literal string or several
+                    # string literals concatenated by the parser (implicit
+                    # adjacency).
+                    pieces = []
+                    for arg in call.args:
+                        if isinstance(arg, ast.Constant) and isinstance(arg.value, str):
+                            pieces.append(arg.value)
+                        elif isinstance(arg, ast.JoinedStr):
+                            raise AssertionError("f-string in _lora_pattern not supported by smoke")
+                        else:
+                            raise AssertionError(f"unexpected arg in re.compile: {ast.dump(arg)}")
+                    return "".join(pieces)
+    raise AssertionError("Qwen3OmniMoeForConditionalGeneration._lora_pattern not found")
+
+
+def _gate_source_present() -> bool:
+    """Verify the should_apply_lora opt-in gate is wired into lora_manager."""
+    src = LORA_MGR_FILE.read_text(encoding="utf-8")
+    needles = [
+        'getattr(self.base_model, "should_apply_lora", None)',
+        "if callable(should_apply) and not should_apply(module_name):",
+        "continue",
+    ]
+    return all(n in src for n in needles)
+
+
+def main() -> int:
+    pattern_src = _extract_lora_pattern_source()
+    print(f"[ok] extracted _lora_pattern source ({len(pattern_src)} chars)")
+    pattern = re.compile(pattern_src)
+
+    must_match = [
+        "thinker.model.layers.0.self_attn.qkv_proj",
+        "thinker.model.layers.47.self_attn.o_proj",
+        "thinker.model.layers.5.mlp.experts",
+        "thinker.lm_head",
+        "thinker.model.embed_tokens",
+    ]
+    must_not_match = [
+        "thinker.audio_tower.layers.0.self_attn.qkv_proj",
+        "thinker.audio_tower.layers.31.self_attn.o_proj",
+        "thinker.audio_tower.layers.5.fc1",
+        "thinker.audio_tower.conv1",
+        "thinker.visual.blocks.5.attn.qkv",
+        "thinker.visual.merger.mlp.0",
+        "thinker.visual.patch_embed.proj",
+        "talker.model.layers.0.self_attn.qkv_proj",
+        "model.layers.0.self_attn.qkv_proj",
+        "thinker.model.embed_tokens.weight",
+        "thinker.model.layers.0.input_layernorm",
+    ]
+
+    failures: list[str] = []
+    for name in must_match:
+        if not pattern.match(name):
+            failures.append(f"  FAIL: expected match but did NOT match: {name!r}")
+    for name in must_not_match:
+        if pattern.match(name):
+            failures.append(f"  FAIL: expected NO match but DID match: {name!r}")
+
+    if not _gate_source_present():
+        failures.append(
+            "  FAIL: lora_manager.py is missing the should_apply_lora gate code"
+        )
+    else:
+        print("[ok] should_apply_lora gate is present in lora_manager.py")
+
+    if failures:
+        print(f"\n{len(failures)} failure(s):")
+        for f in failures:
+            print(f)
+        return 1
+
+    print(
+        f"[ok] regex accepts {len(must_match)} LLM names, "
+        f"rejects {len(must_not_match)} non-LLM names"
+    )
+    print("\nAll offline checks passed.")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
