+def test_model_worker_load_lora_adapter_from_flattened_tensors() -> None:
+    import pickle
+
+    import pybase64
+    import torch
+    from sglang.srt.weight_sync.tensor_bucket import FlattenedTensorBucket
+
+    from sglang_omni.model_runner.model_worker import ModelWorker
+
+    tensor_name = (
+        "base_model.model.thinker.model.layers.0."
+        "self_attn.o_proj.lora_A.weight"
+    )
+    expected = torch.arange(6, dtype=torch.float32).reshape(2, 3)
+    bucket = FlattenedTensorBucket(named_tensors=[(tensor_name, expected)])
+    flattened_tensor_data = {
+        "flattened_tensor": bucket.flattened_tensor,
+        "metadata": bucket.metadata,
+    }
+    serialized_tensors = pybase64.b64encode(
+        pickle.dumps(flattened_tensor_data)
+    ).decode("utf-8")
+    config_dict = {
+        "peft_type": "LORA",
+        "r": 2,
+        "lora_alpha": 4,
+        "target_modules": ["o_proj"],
+    }
+    added_tokens_config = {"added_tokens_decoder": {}}
+    captured: dict = {}
+
+    def fake_load(lora_ref, tensors, config, added_tokens_config):
+        captured.update(
+            lora_ref=lora_ref,
+            tensors=tensors,
+            config=config,
+            added_tokens_config=added_tokens_config,
+        )
+        return SimpleNamespace(success=True, error_message="")
+
+    worker = object.__new__(ModelWorker)
+    worker.model_runner = SimpleNamespace(
+        load_lora_adapter_from_tensors=fake_load
+    )
+
+    ok, msg = ModelWorker.load_lora_adapter_from_tensors(
+        worker,
+        {
+            "lora_name": "policy",
+            "serialized_tensors": serialized_tensors,
+            "config_dict": config_dict,
+            "load_format": "flattened_bucket",
+            "pinned": True,
+            "added_tokens_config": added_tokens_config,
+        },
+    )
+
+    assert ok is True
+    assert msg == ""
+    assert set(captured["tensors"]) == {tensor_name}
+    restored = captured["tensors"][tensor_name]
+    assert restored.shape == expected.shape
+    assert restored.dtype == expected.dtype
+    assert torch.equal(restored, expected)
+    assert captured["config"] is config_dict
+    assert captured["added_tokens_config"] is added_tokens_config
+    ref = captured["lora_ref"]
+    assert ref.lora_name == "policy"
+    assert ref.lora_id == "policy"
+    assert ref.lora_path == "__tensor__"
+    assert ref.pinned is True
+
