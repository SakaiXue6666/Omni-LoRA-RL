+        remove = getattr(eviction_policy, "remove", None)
+        if callable(remove):
+            remove(lora_id)
+        logger.debug(
+            "Invalidated unloaded LoRA %r from GPU memory pool slot %r",
+            lora_id,
+            buffer_id,
+        )
