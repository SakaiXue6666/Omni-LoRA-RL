@@ -0,0 +1,626 @@
+# SPDX-License-Identifier: Apache-2.0
+"""CPU-only wiring tests for LoRA hot-load support in sglang-omni.
+
+These do not load a model or start a GPU. They pin the plumbing added to enable
+LoRA on the Qwen3-Omni thinker: admin dispatch, ModelWorker delegation, the
+scheduler-side enable_lora flag helpers, and the thinker model's LoRA gate.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+from sglang_omni.proto.admin import (
+    ADMIN_FLUSH_CACHE,
+    ADMIN_LOAD_LORA_ADAPTER,
+    ADMIN_LOAD_LORA_ADAPTER_FROM_TENSORS,
+    ADMIN_UNLOAD_LORA_ADAPTER,
+    is_update_action,
+)
+from sglang_omni.scheduling.omni_scheduler import OmniScheduler
+
+
+def _bare_scheduler(model_worker) -> OmniScheduler:
+    scheduler = object.__new__(OmniScheduler)
+    scheduler._admin_lock = threading.Lock()
+    scheduler.model_worker = model_worker
+    return scheduler
+
+
+def test_admin_load_lora_adapter_delegates_to_worker() -> None:
+    calls: list[dict] = []
+    scheduler = _bare_scheduler(
+        SimpleNamespace(
+            load_lora_adapter=lambda payload: calls.append(payload) or (True, "ok")
+        )
+    )
+
+    result = OmniScheduler._admin_load_lora_adapter(
+        scheduler,
+        {"lora_name": "adapter0", "lora_path": "/tmp/adapter0"},
+    )
+
+    assert result["success"] is True
+    assert result["data"]["lora_name"] == "adapter0"
+    assert calls == [{"lora_name": "adapter0", "lora_path": "/tmp/adapter0"}]
+
+
+def test_admin_load_lora_adapter_requires_name_and_path() -> None:
+    scheduler = _bare_scheduler(
+        SimpleNamespace(load_lora_adapter=lambda payload: (True, "ok"))
+    )
+
+    result = OmniScheduler._admin_load_lora_adapter(
+        scheduler, {"lora_name": "adapter0"}
+    )
+
+    assert result["success"] is False
+    assert "lora_path" in result["message"]
+
+
+def test_admin_load_lora_adapter_unsupported_stage_is_skipped() -> None:
+    # A stage whose worker lacks load_lora_adapter (e.g. vocoder) must no-op.
+    scheduler = _bare_scheduler(SimpleNamespace())
+
+    result = OmniScheduler._admin_load_lora_adapter(
+        scheduler,
+        {"lora_name": "adapter0", "lora_path": "/tmp/adapter0"},
+    )
+
+    assert result["success"] is True
+    assert result["data"]["unsupported"] is True
+
+
+def test_admin_load_lora_adapter_from_tensors_delegates_to_worker() -> None:
+    calls: list[dict] = []
+    scheduler = _bare_scheduler(
+        SimpleNamespace(
+            load_lora_adapter_from_tensors=lambda payload: calls.append(payload)
+            or (True, "ok")
+        )
+    )
+    payload = {
+        "lora_name": "policy",
+        "serialized_tensors": "encoded",
+        "config_dict": {"peft_type": "LORA"},
+        "load_format": "flattened_bucket",
+    }
+
+    result = OmniScheduler._admin_load_lora_adapter_from_tensors(
+        scheduler, payload
+    )
+
+    assert result["success"] is True
+    assert result["data"]["lora_name"] == "policy"
+    assert calls == [payload]
+
+
+@pytest.mark.parametrize(
+    "payload",
+    [
+        {"serialized_tensors": "encoded", "config_dict": {}},
+        {"lora_name": "policy", "config_dict": {}},
+        {"lora_name": "policy", "serialized_tensors": "encoded"},
+        {
+            "lora_name": "policy",
+            "serialized_tensors": "encoded",
+            "config_dict": [],
+        },
+    ],
+)
+def test_admin_load_lora_adapter_from_tensors_requires_payload_fields(
+    payload: dict,
+) -> None:
+    scheduler = _bare_scheduler(
+        SimpleNamespace(load_lora_adapter_from_tensors=lambda payload: (True, "ok"))
+    )
+
+    result = OmniScheduler._admin_load_lora_adapter_from_tensors(
+        scheduler, payload
+    )
+
+    assert result["success"] is False
+    assert result["error"]
+
+
+def test_admin_load_lora_adapter_from_tensors_unsupported_stage_is_skipped() -> None:
+    scheduler = _bare_scheduler(SimpleNamespace())
+
+    result = OmniScheduler._admin_load_lora_adapter_from_tensors(
+        scheduler,
+        {
+            "lora_name": "policy",
+            "serialized_tensors": "encoded",
+            "config_dict": {},
+        },
+    )
+
+    assert result["success"] is True
+    assert result["data"] == {"skipped": True, "unsupported": True}
+    assert is_update_action(ADMIN_LOAD_LORA_ADAPTER_FROM_TENSORS)
+
+
+def test_admin_unload_lora_adapter_delegates_to_worker() -> None:
+    calls: list[dict] = []
+    scheduler = _bare_scheduler(
+        SimpleNamespace(
+            unload_lora_adapter=lambda payload: calls.append(payload) or (True, "ok")
+        )
+    )
+
+    result = OmniScheduler._admin_unload_lora_adapter(
+        scheduler, {"lora_name": "adapter0"}
+    )
+
+    assert result["success"] is True
+    assert calls == [{"lora_name": "adapter0"}]
+
+
+def test_run_admin_action_routes_lora_actions() -> None:
+    load_calls: list[dict] = []
+    tensor_calls: list[dict] = []
+    unload_calls: list[dict] = []
+    scheduler = _bare_scheduler(
+        SimpleNamespace(
+            load_lora_adapter=lambda payload: load_calls.append(payload) or (True, "l"),
+            load_lora_adapter_from_tensors=lambda payload: tensor_calls.append(payload)
+            or (True, "t"),
+            unload_lora_adapter=lambda payload: unload_calls.append(payload)
+            or (True, "u"),
+        )
