@@ -0,0 +1,52 @@
+# SPDX-License-Identifier: Apache-2.0
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import torch
+from sglang.srt.model_executor.forward_context import (
+    get_attn_backend,
+    has_forward_context,
+)
+
+from sglang_omni.models.qwen3_omni.talker_model_runner import QwenTalkerModelRunner
+
+
+def test_projected_prefill_forward_publishes_attention_backend() -> None:
+    """Custom Talker prefill keeps SGLang KV-cache helpers inside a context."""
+    seen_backends: list[object] = []
+
+    class FakeAttentionBackend:
+        def init_forward_metadata(self, _forward_batch: object) -> None:
+            seen_backends.append(get_attn_backend())
+
+    class FakeModel:
+        activation_dtype = torch.float32
+
+        def __call__(self, **_kwargs: object) -> SimpleNamespace:
+            seen_backends.append(get_attn_backend())
+            return SimpleNamespace(hidden_states=None)
+
+    backend = FakeAttentionBackend()
+    runner = object.__new__(QwenTalkerModelRunner)
+    runner.tp_worker = SimpleNamespace(
+        model_runner=SimpleNamespace(attn_backend=backend)
+    )
+    runner.model = FakeModel()
+    forward_batch = SimpleNamespace(
+        input_ids=torch.tensor([1, 2]),
+        positions=torch.tensor([0, 1]),
+        mrope_positions=None,
+    )
+
+    assert not has_forward_context()
+    result = runner._forward_with_input_embeds(
+        forward_batch,
+        input_embeds=torch.randn(2, 4),
+        input_embeds_are_projected=True,
+    )
+
+    assert result.logits_output.hidden_states is None
+    assert seen_backends == [backend, backend]
+    assert not has_forward_context()
